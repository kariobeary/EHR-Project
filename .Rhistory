dplyr::mutate(
Patient Location = case_when(
# Display the table using kable
kable(summary_table, caption = "Patient Characteristics Grouped by Location")
# Rename Location Options
summary_table <- summary_table %>%
mutate(
Patient Location = case_when(
# Rename Location Options
summary_table <- summary_table %>%
mutate(
`Patient Location` = case_when(
