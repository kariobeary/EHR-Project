summarize(summary(PAT_AGE))
diagnostic %>% group_by(PAT_DPT_GRP) %>%
summarize(minAge = min(PAT_AGE), maxAge = max(PAT_AGE))
View(summary_table)
# Renaming columns
colnames(summary_table) <- c("Patient Location", "Median Age", "Percent Male (%)")
View(summary_table)
# Rename Location Options
summary_table <- summary_table %>%
mutate(`Patient Location` = case_when(`Patient Location` == "IF" ~ "Ile de France",
`Patient Location` == "NE" ~ "Northeast",
`Patient Location` == "NW" ~ "Northwest",
`Patient Location` == "SE" ~ "Southeast",
`Patient Location` == "SW" ~ "Southwest",
TRUE ~ `Patient Location`))
View(summary_table)
summary_table <- diagnostic %>%
group_by(PAT_DPT_GRP) %>%
summarize(Median_Age = median(PAT_AGE, na.rm = TRUE),
Number_of_Males = sum(PAT_SEX_COD == 1, na.rm = TRUE),
Percent_Males = (Number_of_Males / n()) * 100) %>%
mutate('Number Males (%)' = paste0(Number_of_Males, " (",
sprintf("%.1f%%", Percent_Males), ")")) %>%
dplyr::select(-Number_of_Males, -Percent_Males)  # Drop intermediate columns
# Renaming columns
colnames(summary_table) <- c("Patient Location", "Median Age", "Percent Male (%)")
# Rename Location Options
summary_table <- summary_table %>%
mutate(`Patient Location` = case_when(`Patient Location` == "IF" ~ "Ile de France",
`Patient Location` == "NE" ~ "Northeast",
`Patient Location` == "NW" ~ "Northwest",
`Patient Location` == "SE" ~ "Southeast",
`Patient Location` == "SW" ~ "Southwest",
TRUE ~ `Patient Location`))
summary_table <- diagnostic %>%
group_by(PAT_DPT_GRP) %>%
summarize(Median_Age = median(PAT_AGE, na.rm = TRUE),
Number_of_Males = sum(PAT_SEX_COD == 1, na.rm = TRUE),
Percent_Males = (Number_of_Males / n()) * 100) %>%
mutate('Number Males (%)' = paste0(Number_of_Males, " (",
sprintf("%.1f%%", Percent_Males), ")")) %>%
dplyr::select(-Number_of_Males, -Percent_Males)  # Drop intermediate columns
# Renaming columns
colnames(summary_table) <- c("Patient Location", "Median Age", "Percent Male (%)")
summary_table[1:6, 1] <- c("Ile de France", "Northeast", "Northwest", "Other",
"Southeast", "Southwest")
# Display the table using kable
kable(summary_table, caption = "Patient Characteristics Grouped by Location")
?kable
