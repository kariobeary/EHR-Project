ifelse(pat$PAT_DEATH_DATE != "", date(pat$PAT_DEATH_DATE), NA)
pat$PAT_DEATH_DATE
ifelse(pat$PAT_DEATH_DATE == "", date(pat$PAT_DEATH_DATE), NA)
ifelse(pat$PAT_DEATH_DATE == "", NA, date(pat$PAT_DEATH_DATE))
ifelse(pat$PAT_DEATH_DATE == NULL, NA, date(pat$PAT_DEATH_DATE))
ifelse(is.null(pat$PAT_DEATH_DATE), NA, date(pat$PAT_DEATH_DATE))
ifelse(is.na(pat$PAT_DEATH_DATE), NA, date(pat$PAT_DEATH_DATE))
unique(pat$PAT_BIRTH_DATE)
unique(pat$PAT_DEATH_DATE)
pat$PAT_DEATH_DATE == ""
pat$PAT_DEATH_DATE == NA
ifelse(pat$PAT_DEATH_DATE == "", 0, 1)
ifelse(pat$PAT_DEATH_DATE == "", 0, pat$PAT_DEATH_DATE)
ifelse(pat$PAT_DEATH_DATE == "", NA, pat$PAT_DEATH_DATE)
ifelse(pat$PAT_DEATH_DATE == "", NULL, pat$PAT_DEATH_DATE)
ifelse(pat$PAT_DEATH_DATE == "", NA, date(pat$PAT_DEATH_DATE))
ifelse(pat$PAT_DEATH_DATE == "", NA, as.date(pat$PAT_DEATH_DATE))
date(ifelse(pat$PAT_DEATH_DATE == "", NA, pat$PAT_DEATH_DATE))
