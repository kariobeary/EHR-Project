View(pres)
# New dataframe for diabetes prescriptions ---------------------------
pres %>% filter(DRUG_ATC_C07 %in% "A10A")
# New dataframe for diabetes prescriptions ---------------------------
pres %>% filter(str_detect(DRUG_ATC_C07, "A10A"))
# New dataframe for diabetes prescriptions ---------------------------
pres %>% filter(str_detect(DRUG_ATC_C07, "A10A") | str_detect(DRUG_ATC_C07, "A10B") )
# New dataframe for diabetes prescriptions ---------------------------
pres %>% filter(str_detect(DRUG_ATC_C07, "A10A") | str_detect(DRUG_ATC_C07, "A10B")) %>%
distinct()
# New dataframe for diabetes prescriptions ---------------------------
pres %>% filter(str_detect(DRUG_ATC_C07, "A10A") | str_detect(DRUG_ATC_C07, "A10B")) %>%
distinct(DRUG_ATC_C07)
# New dataframe for diabetes prescriptions ---------------------------
pres_diab <- pres %>% filter(str_detect(DRUG_ATC_C07, "A10A") |
str_detect(DRUG_ATC_C07, "A10B"))
unique(pres_diab$DRUG_ATC_C07)
table(pres_diab$DRUG_ATC_C07)   # double-check that A10As and A10Bs have been selected
summary(pres_diab$DRUG_ATC_C07)   # double-check that A10As and A10Bs have been selected
