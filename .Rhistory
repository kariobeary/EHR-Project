tbl_summary(by = PAT_DPT_GRP)
diagnostic %>% select(c(PAT_DPT_GRP, PAT_AGE, PAT_SEX_COD)) %>%
tbl_summary(by = PAT_DPT_GRP)
diagnostic %>% select("PAT_DPT_GRP", "PAT_AGE", "PAT_SEX_COD") %>%
tbl_summary(by = "PAT_DPT_GRP")
diagnostic %>% dypler::select("PAT_DPT_GRP", "PAT_AGE", "PAT_SEX_COD") %>%
tbl_summary(by = "PAT_DPT_GRP")
diagnostic %>% dyplr::select("PAT_DPT_GRP", "PAT_AGE", "PAT_SEX_COD") %>%
tbl_summary(by = "PAT_DPT_GRP")
diagnostic %>% dplyr::select("PAT_DPT_GRP", "PAT_AGE", "PAT_SEX_COD") %>%
